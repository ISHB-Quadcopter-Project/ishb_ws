<launch>
  <!-- SUPER's planner, transplanted. NOTE: pkg is super_planner (not mission_planner
       as my earlier placeholder guessed), per the stock click_demo.launch -->
  <node pkg="super_planner" name="fsm_node" type="fsm_node" output="screen">

    <!-- Their option 1: absolute config path -> our own copy, stock tree untouched -->
    <param name="config_path" value="$(find ishb_bringup)/config/phase2_super.yaml" type="string"/>

  </node>

  <!-- perfect_drone: deliberately absent (MARSIM+FAST-LIO replace it) -->
  <!-- Their two rviz nodes: also dropped; we run one combined rviz ourselves -->
</launch>
